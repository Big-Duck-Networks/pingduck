# ==============================================================================
# PingDuck Environment Variables (.env)
# ==============================================================================
# Copy this file to `.env` in `pingduck_app/` and fill in your keys.
# Run or build with:
#   flutter run --dart-define-from-file=.env
#   powershell -File tools\build.ps1 apk
# ==============================================================================

# PostHog Product Analytics & Crash Reporting
# Project token from PostHog Project Settings -> Project Variables (starts with phc_)
POSTHOG_PROJECT_TOKEN=phc_REPLACE_ME

# PostHog Ingestion Host (default: https://us.i.posthog.com, or https://eu.i.posthog.com for EU)
POSTHOG_HOST=https://us.i.posthog.com

# RevenueCat Android Public SDK Key (optional override)
# REVENUECAT_ANDROID_KEY=goog_...

# Supabase Configuration (optional overrides)
# SUPABASE_URL=https://rumwtzzyrhzudguolasq.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
