# Keep the build context small: the image needs core/ sources and agent/.
# (Explicit paths: a pattern like **/build* would also drop build.rs.)
core/build*
core/out
core/fuzz/corpus
agent/target
# The app is not in the image, except the vendor registry the agent ships.
pingduck_app
!pingduck_app/assets/oui_database/oui.csv
packages
store
supabase
docs
.git
.claude
